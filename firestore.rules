rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---
    function hasRole(role) {
      return request.auth.token.role == role;
    }
    function isAdmin() {
      return hasRole('ADMIN') || hasRole('OPERATIONS_MANAGER');
    }
    function isHouseLead() {
      return hasRole('HOUSE_LEAD');
    }
    function isStaff() {
      // Must have a valid role, not just be authenticated
      return isAdmin() || isHouseLead();
    }

    // --- USERS ---
    match /users/{userId} {
      // Users can read/write their own non-role data. 
      // STRICT: Prevent users from elevating their own role if you store it in the doc (you shouldn't).
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /files/{fileId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // --- CORE ENTITIES ---

    // MEMBERS
    match /members/{memberId} {
      allow read: if isStaff();
      
      // CREATE: Admin only. MUST initialize ledger fields to defaults (0/-1/false).
      allow create: if isAdmin() 
        && request.resource.data.accountBalance == 0
        && request.resource.data.hasOutstandingBalance == false
        && request.resource.data.lastBilledPeriodIndex == -1
        && request.resource.data.lastBilledThrough == null;

      // UPDATE: Admin only. DENY changes to ledger fields.
      allow update: if isAdmin() 
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(
             ['accountBalance', 'lastBilledPeriodIndex', 'lastBilledThrough', 'hasOutstandingBalance', 'legacyBalance', 'status', 'exitDate']
           ));
    }

    // HOUSES
    match /houses/{houseId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    
    // SPONSORSHIPS
    match /sponsorships/{sponsorshipId} {
      allow read, write: if isAdmin();
    }

    // --- FINANCIAL LEDGER (READ-ONLY for Client) ---
    match /bedCharges/{docId} { allow read: if isAdmin(); allow write: if false; }
    match /sponsorshipCharges/{docId} { allow read: if isAdmin(); allow write: if false; }
    match /memberPayments/{docId} { allow read: if isAdmin(); allow write: if false; }
    match /memberAdjustments/{docId} { allow read: if isAdmin(); allow write: if false; }
    
    // SUMMARIES (Read-only)
    match /memberMonthlySummaries/{docId} { allow read: if isAdmin(); allow write: if false; }
    match /sponsorMonthlySummaries/{docId} { allow read: if isAdmin(); allow write: if false; }
    match /houseMonthlySummaries/{docId} { allow read: if isAdmin(); allow write: if false; }

    // --- OPERATIONS ---

    // WORK ORDERS
    match /workOrders/{workOrderId} {
      allow read: if isStaff();
      // Any staff can create
      allow create: if isStaff();
      // Admins: Full update. Leads: Only status/notes (simplified restriction for now, or full update if trusted).
      // RESTRICTION: Leads cannot change 'reportedByUserId' or 'houseId' after creation.
      allow update: if isAdmin() || (isHouseLead() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['houseId', 'reportedByUserId']));
    }

    // INVENTORY
    match /inventoryItems/{itemId} {
      allow read: if isStaff();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isHouseLead() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // MAINTENANCE TASKS
    match /maintenanceTasks/{taskId} {
      allow read: if isStaff();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isHouseLead() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastCompletedDate', 'nextDueDate', 'updatedAt']));
      allow delete: if isAdmin();
    }
    
    // SYSTEM ERRORS
    match /systemErrors/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}