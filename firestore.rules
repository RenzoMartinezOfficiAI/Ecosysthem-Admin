rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      // Safely check if the user document exists before trying to access it
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
             ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
             : null;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'ADMIN';
    }

    function isOpsManager() {
      return isAuthenticated() && (getUserRole() == 'OPERATIONS_MANAGER' || getUserRole() == 'ADMIN');
    }

    function isHouseLead() {
      return isAuthenticated() && (getUserRole() == 'HOUSE_LEAD' || isOpsManager());
    }
    
    function isStaff() {
      return isHouseLead(); 
    }

    // --- USERS ---
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      allow read: if isAdmin();
    }

    // --- CORE ENTITIES ---

    match /members/{memberId} {
      allow read: if isStaff();
      allow create, update, delete: if isOpsManager();
    }

    match /houses/{houseId} {
      allow read: if isStaff();
      allow write: if isOpsManager();
    }
    
    match /sponsorships/{sponsorshipId} {
      allow read, write: if isOpsManager();
    }

    match /bedCharges/{docId} { allow read, write: if isOpsManager(); }
    match /sponsorshipCharges/{docId} { allow read, write: if isOpsManager(); }
    
    match /memberPayments/{docId} { allow read: if isOpsManager(); allow write: if false; }
    match /memberAdjustments/{docId} { allow read: if isOpsManager(); allow write: if false; } 
    match /adjustments/{docId} { allow read, write: if isOpsManager(); } 

    // --- OPERATIONS ---

    match /workOrders/{workOrderId} {
      allow read, create, update: if isStaff();
    }

    match /inventoryItems/{itemId} {
      allow read, write: if isStaff();
    }

    // Explicitly allow read for testing purposes if strict role fails, but keeping it staff only for now.
    // Ensure index exists for the query.
    match /maintenance_tasks/{taskId} {
      allow read, write: if isStaff();
    }
    
    match /maintenanceTasks/{taskId} {
      allow read, write: if isStaff();
    }
    
    match /systemErrors/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}