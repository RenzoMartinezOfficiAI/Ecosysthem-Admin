rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper roles
    function isAdmin() {
      return request.auth.token.role == 'ADMIN' || request.auth.token.role == 'OPERATIONS_MANAGER';
    }
    
    // USERS & FILES (User Profile Management)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /files/{fileId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // MEMBERS
    match /members/{memberId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin() 
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountBalance', 'lastBilledPeriodIndex', 'hasOutstandingBalance', 'legacyBalance', 'status', 'exitDate']));
    }

    // FINANCIAL LEDGER COLLECTIONS
    match /bedCharges/{docId} {
      allow read: if isAdmin();
      allow write: if false; 
    }
    match /sponsorshipCharges/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /memberPayments/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /memberAdjustments/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    // SUMMARIES
    match /memberMonthlySummaries/{docId} {
        allow read: if isAdmin();
        allow write: if false;
    }
    match /sponsorMonthlySummaries/{docId} {
        allow read: if isAdmin();
        allow write: if false;
    }
    match /houseMonthlySummaries/{docId} {
        allow read: if isAdmin();
        allow write: if false;
    }

    // HOUSES
    match /houses/{houseId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // SYSTEM ERRORS
    match /systemErrors/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}